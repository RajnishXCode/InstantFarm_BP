{
  "name": "instant-farm",
  "version": "1.2.1",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --outfile=behavior_pack/scripts/main.js --bundle --format=esm --external:@minecraft/server",
    "watch": "esbuild src/main.ts --outfile=behavior_pack/scripts/main.js --bundle --format=esm --external:@minecraft/server --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@minecraft/server": "2.11.0"
  },
  "devDependencies": {
    "esbuild": "^0.20.0",
    "typescript": "^5.0.0"
  }
}
